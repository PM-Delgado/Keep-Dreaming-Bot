# Copy to .env and fill in. .env is git-ignored; never commit it.
# Bot token: Developer Portal -> your application -> Bot -> Reset Token
# (NOT the Public Key or Client Secret).
DISCORD_TOKEN=your-bot-token
# Your dev server's ID (Discord Developer Mode -> right-click server -> Copy Server ID)
GUILD_ID=your-dev-server-id
ASSETS_URL=https://pm-delgado.github.io/Keep-Dreaming-Bot/assets/
# Optional: SQLite file location (default: data/kdbot.sqlite3)
# DB_PATH=data/kdbot.sqlite3
# Discord user IDs allowed to run admin-only commands (rating/role overrides, corrections).
# Comma-separated; empty means nobody. Developer Mode -> right-click a user -> Copy User ID.
# ADMIN_USER_IDS=123456789012345678,234567890123456789
# Optional Riot Games API key (developer.riotgames.com). Without it the /riot commands are
# disabled and ranks/roles can still be set manually. Never commit it.
# RIOT_API_KEY=RGAPI-...
# Platform used when /riot link does not specify one (default: euw1)
# RIOT_DEFAULT_PLATFORM=euw1
# Lobby ready-check length in seconds (default 120; use e.g. 30 while testing)
# READY_CHECK_SECONDS=120
# Enables /admin mock ...: fake players for testing lobbies alone. Leave OFF in production.
# ENABLE_MOCK_PLAYERS=true
